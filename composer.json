{
    "name": "sms-partners/php-sdk",
    "description": "Official PHP SDK for the SMS Partners API.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.0.1"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SmsPartners\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmsPartners\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
